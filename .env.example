# Jira Server/DC (REST API v2, Bearer Personal Access Token)
JIRA_BASE_URL=https://jira.example.com
JIRA_PAT=
# JIRA_JQL=assignee = currentUser() AND issuetype = Bug AND resolution = Unresolved ORDER BY priority DESC

# Telegram bot (create via @BotFather). Only updates from this chat are accepted.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Scheduling (Go duration format)
POLL_INTERVAL=5m
REMIND_INTERVAL=4h
SNOOZE_CHOICES=30m,2h,24h

DB_PATH=./data/tasks.db
TZ=Asia/Ho_Chi_Minh

# Phase 2: Jira project -> candidate GitLab repos (see repos.example.json)
REPOS_FILE=./repos.json
# Format of the maintainer's scope comment that "Fix it" requires (see scope.example.json;
# missing file = built-in default). Edit it to change the marker/fields without touching code.
SCOPE_FILE=./scope.json

# Phase 2 worker (runs on the host: `make worker`)
GITLAB_BASE_URL=https://gitlab.example.com
GITLAB_TOKEN=
# WORKTREE_DIR=   (default: next to each repo clone, so ../sibling-repo references build)
# CLAUDE_BIN=claude
AGENT_TIMEOUT=30m
AGENT_MAX_BUDGET_USD=5
# AGENT_MODEL=
TEST_TIMEOUT=15m
# Resilience: auto-retry transient (network/API) failures, continuing the partial work.
JOB_AUTO_RETRIES=3
JOB_RETRY_DELAY=2m
GIT_NET_TIMEOUT=5m

# E2E browser verification (repos with an "e2e" block in repos.json).
# Web login profiles, git-ignored, chmod 600 (see credentials.example.json; the NVS
# workspace file .secrets/agent-credentials.json has the same "profiles" format).
# E2E_CREDENTIALS_FILE=./.secrets/credentials.json
# NODE_PATH for the agent's Playwright scripts, e.g. $(npm root -g) after `npm i -g playwright`
# E2E_NODE_PATH=

# Handover: fixes auto-merged into dev (repos with "auto_merge"), then dev -> "handover_branch"
# after you confirm on Telegram. Asked only when no job is queued/running.
HANDOVER_MIN_TICKETS=1
PIPELINE_POLL_INTERVAL=1m
PIPELINE_START_TIMEOUT=15m
PIPELINE_TIMEOUT=90m
# Jira after CI/CD succeeds: transition to this status (resolution if the screen asks), then assign to reporter
JIRA_HANDOVER_STATUS=Resolved
JIRA_RESOLUTION=Fixed
