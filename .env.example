# Jira Server/DC (REST API v2, Bearer Personal Access Token)
JIRA_BASE_URL=https://jira.example.com
JIRA_PAT=
# JIRA_JQL=assignee = currentUser() AND issuetype = Bug AND resolution = Unresolved ORDER BY priority DESC

# Telegram bot (create via @BotFather). Only updates from this chat are accepted.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Scheduling (Go duration format)
POLL_INTERVAL=5m
REMIND_INTERVAL=4h
SNOOZE_CHOICES=30m,2h,24h

DB_PATH=./data/tasks.db
TZ=Asia/Ho_Chi_Minh

# Phase 2: Jira project -> candidate GitLab repos (see repos.example.json)
REPOS_FILE=./repos.json
